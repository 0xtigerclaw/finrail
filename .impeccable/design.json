  "narrative": {
    "northStar": "Evidence-first investment workspace",
    "overview": "Finrail uses the owner-confirmed modern fintech light direction: paper and slate neutrals, navy actions, compact financial reading surfaces, and restrained semantic verdict colors. The owner selected light on 26 October 2026 and rejected a dark OLED transformation on 27 October; preserve this light world.\n\nThe system is recorded from the implemented console in code-led mode, without a visual comp. The normative asset source is `console/static/app.css`; `console/static/app.js` supplies progressive interaction, `console/views.py` supplies shared presentation, and `console/app.py` composes server-rendered routes. The surface brief records the confirmed investment-workspace hierarchy; this document records reusable visual behavior.",
    "keyCharacteristics": [
      "Quiet, light surfaces with navy selection and actions.",
      "Compact tables, tabular figures, and readable evidence prose.",
      "Verification, synthetic provenance, and human authority visible in context.",
      "Borders and tonal layers rather than decorative elevation."
    ],
    "rules": [
      {
        "name": "The Accent Discipline Rule",
        "body": "Use navy for actions, links and selection; use semantic colors to communicate recorded state.",
        "section": "colors"
      },
      {
        "name": "The Exact Reference Rule",
        "body": "Keep exact IDs, source references and complete approval hashes readable even when the friendly financial view leads.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal separation and fine borders for ordinary panels; do not restore the obsolete shadow-only card treatment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the owner-pinned light palette and restrained navy action family.",
      "Do keep company identity, synthetic provenance and evidence labels adjacent to the financial content they qualify.",
      "Do use tabular numerals, readable financial units and exact source references together.",
      "Do retain labelled controls, visible focus, inline recovery and keyboard-operable disclosures.",
      "Do keep complete proposals and hashes available before a controlled decision."
    ],
    "donts": [
      "Don't revive the rejected dark application theme or obsolete wrapping mobile navigation.",
      "Don't style illustrative synthetic records as proof of a live model call.",
      "Don't turn decorative shadows, oversized heroes or charts without evidence into the system's identity.",
      "Don't replace drawn icons with emoji or truncate the only readable copy of a hash or artifact ID."
    ]
  }
}
